# ========================================================
# ZelaFix DevOps & Cloud - Exemplo de Variáveis (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais
# ========================================================

# Configurações do Azure
RESOURCE_GROUP=rg-zelafix
LOCATION=eastus
PLAN_NAME=asp-zelafix
SKU=F1
WEB_APP_NAME=app-zelafix-561432
WEB_APP_WORKER_NAME=app-zelafix-worker-561432

# Banco de Dados Oracle FIAP
ORACLE_URL=jdbc:oracle:thin:@//oracle.fiap.com.br:1521/orcl
ORACLE_USER=
ORACLE_PASSWORD=
FLYWAY_ENABLED=true
JPA_DDL_AUTO=none

# RabbitMQ (CloudAMQP - plano gratuito Little Lemur)
# Formato: amqps://USUARIO:SENHA@HOST/VHOST
RABBITMQ_URI=

# Spring AI (Azure AI Foundry - Phi-4 Multimodal)
AI_ACCOUNT_NAME=ai-zelafix-561432
AI_BASE_URL=https://ai-zelafix-561432.services.ai.azure.com/openai/v1
AI_API_KEY=
AI_MODEL=phi-4-multimodal
